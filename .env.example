# Comma-separated list of hero themes that may be served
NEXT_PUBLIC_ENABLED_THEMES=tv-os
NEXT_PUBLIC_DEFAULT_THEME=tv-os
NEXT_PUBLIC_FEATURE_BOOT=true
NEXT_PUBLIC_FEATURE_DEV_OVERLAY=true
# 3D intro only loads on capable desktops; phones always get the lite boot
NEXT_PUBLIC_FEATURE_3D=true
NEXT_PUBLIC_FEATURE_PREVIEWS=true
NEXT_PUBLIC_FEATURE_SOUND=true
NEXT_PUBLIC_FEATURE_GUIDE=true
NEXT_PUBLIC_FEATURE_ATTRACT=true
NEXT_PUBLIC_FEATURE_ASK=true
NEXT_PUBLIC_FEATURE_CONTACT_FORM=true
NEXT_PUBLIC_FEATURE_WEBMCP=true

# Public URL (sitemap, OG image, JSON-LD). Set to the Vercel/custom domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Ask Bhawuk: free Gemini API key from https://aistudio.google.com. Without it, answers come from a local content search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Contact form: free Resend key from https://resend.com. Without it, the form falls back to a prefilled email.
RESEND_API_KEY=
CONTACT_TO=bhawukp@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>
# Optional spam protection (Cloudflare Turnstile, free)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional shared rate limiting (Upstash Redis, free). Falls back to in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
